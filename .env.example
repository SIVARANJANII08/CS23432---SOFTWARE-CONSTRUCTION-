# Copy this file to ".env" and edit. NEVER commit .env to Git.
SECRET_KEY=change-this-to-a-long-random-string
# Leave DATABASE_URL empty to use a local SQLite file while developing.
# On Azure you will paste the Azure SQL connection string here (done in the Azure step).
DATABASE_URL=
# Leave empty to store evidence in the local folder "local_evidence/".
# On Azure you will paste the Storage Account connection string here.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=evidence
MAX_UPLOAD_MB=50
# Set to 1 only when the site is served over HTTPS (Azure). Keep 0 locally.
COOKIE_SECURE=0
# Optional: auto-create the first admin when the database has no users.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
